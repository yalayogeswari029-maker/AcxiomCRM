@model AcxiomCRM.Models.FollowUp

<h1>Delete Follow-Up</h1>

<h3>Are you sure you want to delete this follow-up?</h3>

<div>
    <p><strong>Customer:</strong> @Model.CustomerName</p>
    <p><strong>Date:</strong> @Model.FollowUpDate.ToShortDateString()</p>
    <p><strong>Notes:</strong> @Model.Notes</p>
    <p><strong>Status:</strong> @Model.Status</p>
</div>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>