@model IEnumerable<AcxiomCRM.Models.FollowUp>

<h1>Follow-Ups</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add Follow-Up
    </a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Date</th>
            <th>Notes</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var followUp in Model)
        {
            <tr>
                <td>@followUp.CustomerName</td>
                <td>@followUp.FollowUpDate.ToShortDateString()</td>
                <td>@followUp.Notes</td>
                <td>@followUp.Status</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@followUp.Id"
                       class="btn btn-sm btn-primary">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@followUp.Id"
                       class="btn btn-sm btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>