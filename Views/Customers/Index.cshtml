@model IEnumerable<AcxiomCRM.Models.Customer>

<h1>Customers</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Customer</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Company</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.Name</td>
                <td>@customer.Email</td>
                <td>@customer.Phone</td>
                <td>@customer.Company</td>
                <td>
    <a asp-action="Edit"
       asp-route-id="@customer.Id"
       class="btn btn-sm btn-primary">
        Edit
    </a>

    <a asp-action="Delete"
       asp-route-id="@customer.Id"
       class="btn btn-sm btn-danger">
        Delete
    </a>
</td>
            </tr>
        }
    </tbody>
</table>