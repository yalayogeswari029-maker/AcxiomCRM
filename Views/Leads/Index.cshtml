@model IEnumerable<AcxiomCRM.Models.Lead>

<h1>Leads</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Lead</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Source</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var lead in Model)
        {
            <tr>
                <td>@lead.Name</td>
                <td>@lead.Email</td>
                <td>@lead.Phone</td>
                <td>@lead.Source</td>
                <td>@lead.Status</td>
                <td>
    <a asp-action="Edit"
       asp-route-id="@lead.Id"
       class="btn btn-sm btn-primary">
        Edit
    </a>

    <a asp-action="Delete"
       asp-route-id="@lead.Id"
       class="btn btn-sm btn-danger">
        Delete
    </a>
</td>
            </tr>
        }
    </tbody>
</table>